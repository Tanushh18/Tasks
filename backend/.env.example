# Server
PORT=4000
NODE_ENV=development

# MongoDB
# Leave MONGO_URI unset in local dev to auto-boot an in-memory MongoDB (mongodb-memory-server).
# In production, set this to your MongoDB Atlas connection string. Never commit the real value.
MONGO_URI=

# Auth secrets — generate long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated mobile numbers that get isAdmin=true on registration
# ADMIN_MOBILE_NUMBERS=8130483894

# Cloudinary (document/photo uploads). Leave blank to keep storing files as base64 in MongoDB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=tasks-app

# Outgoing email for "Email my money report" (any SMTP provider, e.g. Gmail app password, Brevo, Resend SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Alternative to SMTP: a Google Apps Script web app that sends the mail (see ../docs/apps-script-mailer.gs)
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=

# ShineOne Estate website photos (Media tab)
CLOUDINARY_CLOUD_NAME_shine=
CLOUDINARY_API_KEY_shine=
CLOUDINARY_API_SECRET_shine=
