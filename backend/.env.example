# Server
PORT=4000
NODE_ENV=development

# MongoDB
# Leave MONGO_URI unset in local dev to auto-boot an in-memory MongoDB (mongodb-memory-server).
# In production, set this to your MongoDB Atlas connection string. Never commit the real value.
MONGO_URI=

# Auth secrets — generate long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
