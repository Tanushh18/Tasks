<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets the app see whether WhatsApp / WhatsApp Business is installed. -->
  <queries>
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
  </queries>

  <application>
    <service
      android:name="expo.modules.whatsappautosender.WhatsAppAutoService"
      android:exported="true"
      android:label="We Three WhatsApp sender"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/whatsapp_auto_accessibility" />
    </service>
  </application>
</manifest>
