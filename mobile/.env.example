# Base URLs of the backend API (see backend/.env.example)
# EXPO_PUBLIC_API_URLS supports comma-separated URLs for automatic fallover:
# If the first URL fails, the client automatically tries the next one.
# - Production: https://tasks-g9h1.onrender.com/api, https://we-three-api.onrender.com/api
# - Local development: http://localhost:4000/api
# - iOS simulator: http://localhost:4000/api
# - Android emulator: http://10.0.2.2:4000/api
# - Physical device (Expo Go): http://<your-computer-LAN-IP>:4000/api
# For local dev, use EXPO_PUBLIC_API_URL (single URL, no fallover needed):
EXPO_PUBLIC_API_URL=http://localhost:4000/api
# For production with fallover, use EXPO_PUBLIC_API_URLS (comma-separated):
# EXPO_PUBLIC_API_URLS=https://tasks-g9h1.onrender.com/api, https://we-three-api.onrender.com/api

# The server list is managed on Stashr (Servers page) and fetched on app start, so URLs above are only
# the bootstrap/fallback. Optional override of where the registry is read from (comma-separated):
# EXPO_PUBLIC_REGISTRY_URLS=https://password-manager-server-xxdr.onrender.com
